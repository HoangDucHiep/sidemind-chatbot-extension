# SideMind · Environment variables template
# Copy file này thành `.env.local` và điền key thật của bạn:
#   cp .env.example .env.local
#
# QUAN TRỌNG:
#   - KHÔNG commit `.env.local` lên git (đã có trong .gitignore)
#   - Mỗi dev tự dùng key riêng để tránh rate-limit chung
#   - File này an toàn để commit (không chứa secret)

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-key

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-key

# Default provider khi cài đặt lần đầu (openai | anthropic | gemini)
DEFAULT_PROVIDER=openai

# Telemetry — OFF mặc định theo FR-09
TELEMETRY_ENABLED=false
